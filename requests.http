@base = http://localhost:8000

### Сервис жив?
GET {{base}}/health

### Создать1
POST {{base}}/api/pets
Content-Type: application/json

{
  "name": "Мурка",
  "kind": "кот",
  "age": 2,
  "owner": "Пётр"
}

### Создать2
POST {{base}}/api/pets
Content-Type: application/json

{
  "name": "Бобик",
  "kind": "собака",
  "age": 10,
  "owner": "Василиса"
}

### Список
GET {{base}}/api/pets

### Получить одну запись
GET {{base}}/api/pets/1

### Изменить
PATCH {{base}}/api/pets/1
Content-Type: application/json

{ 
  "owner": "Лена"
}

### Удалить
DELETE {{base}}/api/pets/1

### После удаления должен быть 404
GET {{base}}/api/pets/1

### Сломанный JSON, должен быть 400
POST {{base}}/api/pets
Content-Type: application/json

[1, 2]



### Создать с ошибкой name
POST {{base}}/api/pets
Content-Type: application/json

{
  "kind": "собака",
  "age": 10,
  "owner": "Василиса"
}

### Создать с ошибкой age
POST {{base}}/api/pets
Content-Type: application/json

{
  "name": "Бобик",
  "kind": "собака",
  "age": -10,
  "owner": "Василиса"
}


### Создать с ошибкой owner
POST {{base}}/api/pets
Content-Type: application/json

{
  "name": "Бобик",
  "kind": "собака",
  "age": 10,
  "owner": 10
}

### Изменить с ошибкой name
PATCH {{base}}/api/pets/1
Content-Type: application/json

{ 
  "name": ""
}

