@base = http://localhost:8000
@basic = Basic ivan:pass123

### health — сервис жив?
GET {{base}}/health


# ЧТЕНИЕ (открыто всем)

### список всех питомцев
GET {{base}}/api/pets

### получить одного
GET {{base}}/api/pets/1

### несуществующий
GET {{base}}/api/pets/999999

### фильтр по виду
GET {{base}}/api/pets?kind=собака

### фильтр по владельцу (логин)
GET {{base}}/api/pets?owner=ivan

### пагинация
GET {{base}}/api/pets?limit=2&offset=4

### пагинация + фильтр
GET {{base}}/api/pets?limit=2&kind=кот

### поиск по имени (q)
GET {{base}}/api/pets?q=Бар

### список визитов питомца
GET {{base}}/api/pets/3/visits

### визиты по месяцам
GET {{base}}/api/pets/stats


# СОЗДАНИЕ (нужна авторизация)

### создать без авторизации
POST {{base}}/api/pets
Content-Type: application/json

{
  "name": "Барсик",
  "kind": "кот",
  "age": 3
}

### создать с Basic
POST {{base}}/api/pets
Authorization: {{basic}}
Content-Type: application/json

{
  "name": "Барсик",
  "kind": "кот",
  "age": 3
}

### создать с Bearer 
POST {{base}}/api/pets
Authorization: Bearer 
Content-Type: application/json

{
  "name": "Мурзик",
  "kind": "кот",
  "age": 5
}

### создать без name 
POST {{base}}/api/pets
Authorization: {{basic}}
Content-Type: application/json

{
  "kind": "собака",
  "age": 10
}

### создать с отрицательным age 
POST {{base}}/api/pets
Authorization: {{basic}}
Content-Type: application/json

{
  "name": "Бобик",
  "kind": "собака",
  "age": -10
}

### сломанный JSON 
POST {{base}}/api/pets
Authorization: {{basic}}
Content-Type: application/json

[1, 2]


# ИЗМЕНЕНИЕ / УДАЛЕНИЕ (только своё, иначе 403)

### обновить своего (Basic)
PATCH {{base}}/api/pets/77
Authorization: {{basic}}
Content-Type: application/json

{
  "age": 4
}

### обновить чужого 
PATCH {{base}}/api/pets/2
Authorization: {{basic}}
Content-Type: application/json

{
  "age": 4
}

### обновить без авторизации 
PATCH {{base}}/api/pets/1
Content-Type: application/json

{
  "age": 4
}

### удалить чужого
DELETE {{base}}/api/pets/8
Authorization: {{basic}}

### удалить своего (Bearer) 
DELETE {{base}}/api/pets/116
Authorization: Bearer 

### создать визит своему питомцу
POST {{base}}/api/pets/3/visits
Authorization: {{basic}}
Content-Type: application/json

{
  "date": "2026-10-01T10:00:00",
  "reason": "Осмотр",
  "diagnosis": "Здоров"
}

### тот же слот повторно
POST {{base}}/api/pets/3/visits
Authorization: {{basic}}
Content-Type: application/json

{
  "date": "2026-10-01T10:00:00",
  "reason": "Осмотр"
}

### визит чужому питомцу 
POST {{base}}/api/pets/2/visits
Authorization: {{basic}}
Content-Type: application/json

{
  "date": "2026-12-01T10:00:00",
  "reason": "Осмотр"
}

### визит без авторизации
POST {{base}}/api/pets/3/visits
Content-Type: application/json

{
  "date": "2026-12-02T10:00:00",
  "reason": "Осмотр"
}


# АУТЕНТИФИКАЦИЯ

### новый юзер
POST {{base}}/auth/register
Content-Type: application/json

{
  "login": "testuser",
  "password": "testpass",
  "name": "Тестовый"
}

### login
POST {{base}}/auth/login
Content-Type: application/json

{
  "login": "ivan",
  "password": "pass123"
}

### неверный пароль 
POST {{base}}/auth/login
Content-Type: application/json

{
  "login": "ivan",
  "password": "wrongpass"
}

### me 
GET {{base}}/auth/me

### me Basic
GET {{base}}/auth/me
Authorization: {{basic}}

### me Bearer
GET {{base}}/auth/me
Authorization: Bearer token