{
  "base_url": "http://localhost:8000",
  "resource": "pets",
  "id_field": "id",
  "missing_id": "999999",
  "list_key": null,
  "create": { 
    "name": "Боб",
    "kind": "кот",
    "age": 3
  },
  "update": {
    "age": 5
  },
  "required_field": "name",
  "errors": [
    { "body": { "name": "" }, "field": "name" },
    { "body": { "kind": 123 }, "field": "kind" },
    { "body": { "age": -1 }, "field": "age" }
  ],
  "filter": {
    "param": "kind",
    "value": "кот",
    "other": "собака"
  },
  "openapi_path": "/openapi.json",
  "text_field": "name",
  "child": {
    "resource": "visits",
    "create": {
      "date": "2026-10-01T10:00:00",
      "reason": "Осмотр",
      "diagnosis": "Здоров"
    },
    "parent_field": "pet_id"
  },
  "rule": {
    "description": "Питомца нельзя записать на два визита в одно время",
    "parent": { "name": "Барсик", "kind": "кот", "age": 3},
    "setup": [
      { "method": "POST", "path": "/api/pets/{id}/visits", "body": { "date": "2026-10-01T10:00:00", "reason": "Осмотр" } }
    ],
    "violate": {
      "method": "POST",
      "path": "/api/pets/{id}/visits",
      "body": { "date": "2026-10-01T10:00:00", "reason": "Повтор" }
    },
    "expect_status": 409
  },
  "search": { "param": "q", "field": "name" },
  "stats_path": "/api/pets/stats",

  "auth": {
    "scheme": "bearer",
    "register_path": "/auth/register",
    "login_path": "/auth/login",
    "me_path": "/auth/me",
    "login_field": "login",
    "password_field": "password",
    "token_field": "access_token",
    "owner_field": "owner_id",
    "admin": { "username": "admin", "password": "admin" }
  }
}
